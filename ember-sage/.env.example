# ─────────────────────────────────────────────────────────────
# Ember & Sage — environment
# Copy to `.env` and adjust. Every value below is optional: with
# no `.env` at all the app runs on SQLite with the demo seed.
# ─────────────────────────────────────────────────────────────

# ── Server ──
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins, or `true` to echo the request origin.
CORS_ORIGIN=true
# Set to `true` to bypass the API rate limiters (useful in CI).
DISABLE_RATE_LIMIT=false

# ── Database ──
# Mongoose is the data layer. With MONGODB_URI set the app talks to a real
# MongoDB; without it the same models run on the built-in SQLite adapter
# (node:sqlite) so the project boots anywhere with zero external services.
# MONGODB_URI=mongodb://127.0.0.1:27017/ember-sage
SQLITE_PATH=.data/ember-sage.sqlite

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
# Session cookie lifetime, in days.
JWT_EXPIRES_DAYS=7
# Origin the password-reset links point at.
APP_URL=http://localhost:5173

# ── Seeding ──
# `false` skips seeding, `force` re-seeds missing data, `force-clear` wipes the DB first.
SEED=true

# ── Email ──
# Gmail example (recommended for a single-restaurant setup):
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account → Security → "App passwords" → create one for Mail.
#   3. Paste the 16-character password into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
# Where contact-form enquiries and table requests are delivered.
MAIL_TO=you@gmail.com
# From-address — leave unset to use SMTP_USER (Gmail requires the sender to
# match the authenticated account).
# MAIL_FROM="Ember & Sage <you@gmail.com>"
#
# Without SMTP_PASS the app uses its dev outbox: every email is stored in the
# EmailLog collection and printed to the server console, so nothing breaks.

# ── Frontend (dev only) ──
# Where `vite` proxies /api and /uploads.
# API_URL=http://localhost:4000
