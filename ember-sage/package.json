{
  "name": "ember-and-sage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/index.js",
    "dev:web": "vite",
    "seed": "node --disable-warning=ExperimentalWarning server/src/utils/seed.js",
    "db:reset": "SEED=force-clear node --disable-warning=ExperimentalWarning server/src/utils/seed.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/src/index.js",
    "preview": "vite preview",
    "test:api": "NODE_ENV=test node --disable-warning=ExperimentalWarning server/test/api.test.mjs",
    "test:render": "NODE_ENV=test node --disable-warning=ExperimentalWarning scripts/render-harness.mjs",
    "mail:test": "node --disable-warning=ExperimentalWarning scripts/mail-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "concurrently": "^9.2.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.5"
  }
}
